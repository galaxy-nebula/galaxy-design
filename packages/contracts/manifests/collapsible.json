  "props": [
    {
      "name": "open",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "angular", "react-native"],
      "description": "Controlled open state.",
      "overrides": {
        "angular": {
          "default": false
        }
      }
    },
    {
      "name": "defaultOpen",
