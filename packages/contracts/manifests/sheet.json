{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "sheet",
  "name": "sheet",
  "category": "other",
  "status": "complete",
  "description": "Overlay layer for secondary tasks such as details, filters or preferences, opened from any edge of the screen.",
  "props": [
    {
      "name": "open",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "angular", "react-native"],
      "description": "Controlled open state.",
      "overrides": {
        "vue": {
          "default": false
        },
        "angular": {
          "default": false
        }
      }
    },
    {
      "name": "defaultOpen",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": false,
      "description": "Initial open state for uncontrolled usage."
    },
    {
      "name": "onOpenChange",
      "type": {
        "kind": "function",
        "signature": "(open: boolean) => void"
      },
      "frameworks": ["react", "react-native", "angular"],
      "description": "Called when the open state changes.",
      "overrides": {
        "angular": {
          "name": "openChange"
        }
      }
    },
    {
      "name": "modal",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue"],
      "default": true,
      "description": "Whether interaction outside the sheet is disabled while open."
    },
    {
      "name": "children",
      "type": {
        "kind": "custom",
        "name": "ReactNode"
      },
      "frameworks": ["react", "react-native"],
      "description": "Sheet composition content."
    },
    {
      "name": "side",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "top"
          },
          {
            "kind": "literal",
            "value": "right"
          },
          {
            "kind": "literal",
            "value": "bottom"
          },
          {
            "kind": "literal",
            "value": "left"
          }
        ]
      },
      "frameworks": ["vue", "angular"],
      "default": "right",
      "description": "Side from which the sheet enters."
    },
    {
      "name": "class",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "frameworks": ["vue", "angular"],
      "default": "",
      "description": "CSS class names for the sheet root wrapper."
    },
    {
      "name": "update:open",
      "type": {
        "kind": "function",
        "signature": "(open: boolean) => void"
      },
      "frameworks": ["vue"],
      "description": "Emitted when the open state changes."
    },
    {
      "name": "show",
      "type": {
        "kind": "function",
        "signature": "({ context, builder, side, isDismissible, enableDrag, backgroundColor, elevation, shape, constraints }) => Future<T?>"
      },
      "frameworks": ["flutter"],
      "description": "Static API to present a modal or side sheet."
    }
  ],
