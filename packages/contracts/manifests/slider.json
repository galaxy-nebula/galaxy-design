          }
        },
        "vue": {
          "name": "modelValue"
        }
      }
    },
    {
      "name": "onValueChange",
      "type": {
        "kind": "function",
        "signature": "(value: number[]) => void"
      },
      "frameworks": ["react", "react-native", "angular"],
      "description": "Called when the slider values change.",
      "overrides": {
        "angular": {
          "name": "valueChange",
          "type": {
            "kind": "function",
            "signature": "(value: number) => void"
          }
        }
      }
    },
    {
      "name": "onValueCommit",
      "type": {
        "kind": "function",
        "signature": "(value: number[]) => void"
      },
      "frameworks": ["react", "react-native", "vue"],
      "description": "Called when the interaction ends and the slider values are committed.",
      "overrides": {
        "vue": {
          "name": "valueCommit"
        }
      }
    },
    {
      "name": "name",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "frameworks": ["react", "vue", "react-native"],
      "description": "Name used for the hidden inputs in form submission."
    },
    {
      "name": "disabled",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "angular", "react-native", "flutter"],
      "default": false,
      "description": "Disables the slider."
    },
    {
      "name": "orientation",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "horizontal"
          },
          {
            "kind": "literal",
            "value": "vertical"
          }
        ]
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": "horizontal",
      "description": "Slider orientation."
    },
    {
      "name": "dir",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "ltr"
          },
          {
            "kind": "literal",
            "value": "rtl"
          }
        ]
      },
      "frameworks": ["react", "vue", "react-native"],
      "description": "Reading direction."
    },
    {
      "name": "inverted",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": false,
      "description": "Whether the slider is visually inverted."
    },
    {
      "name": "min",
      "type": {
        "kind": "primitive",
        "name": "number"
      },
      "frameworks": ["react", "vue", "angular", "react-native", "flutter"],
      "default": 0,
      "description": "Minimum value."
    },
    {
      "name": "max",
      "type": {
        "kind": "primitive",
        "name": "number"
      },
      "frameworks": ["react", "vue", "angular", "react-native", "flutter"],
      "default": 100,
      "description": "Maximum value."
    },
    {
      "name": "step",
      "type": {
        "kind": "primitive",
        "name": "number"
      },
      "frameworks": ["react", "vue", "angular", "react-native"],
      "default": 1,
      "description": "Stepping interval."
    },
    {
      "name": "minStepsBetweenThumbs",
