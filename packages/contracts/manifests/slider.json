        "kind": "primitive",
        "name": "number"
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": 0,
      "description": "Minimum permitted steps between thumbs."
    },
    {
      "name": "form",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "frameworks": ["react"],
