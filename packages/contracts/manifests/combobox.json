{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "combobox",
  "name": "Combobox",
  "category": "form",
  "status": "complete",
  "description": "Searchable select with filtering, combining a text input with a dropdown list.",
  "props": [
    {
      "name": "options",
      "type": {
        "kind": "array",
        "of": {
          "kind": "custom",
          "name": "{ value: string; label: string }"
        }
      },
      "description": "Available options to select from.",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "value",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "description": "Selected value.",
      "frameworks": [
        "react",
        "vue"
      ],
      "overrides": {
        "vue": {
          "name": "modelValue"
        }
      }
    },
    {
      "name": "placeholder",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "default": "Select...",
      "description": "Placeholder text.",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "disabled",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "default": false,
      "description": "Disables the combobox.",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "class",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "frameworks": [
        "react",
        "vue"
      ],
      "overrides": {
        "react": {
          "name": "className"
        }
      }
    }
  ],
  "children": [],
  "frameworks": {
    "react": {
      "status": "complete",
      "files": [
        "Combobox.tsx",
        "index.ts"
      ],
      "entry": "index.ts",
      "exports": [
        "Combobox",
        "ComboboxProps",
        "ComboboxOption"
      ],
      "dependencies": [
        "cmdk"
      ],
      "registryDependencies": [
        "command",
        "popover",
        "button"
      ],
      "props": []
    },
    "vue": {
      "status": "complete",
      "files": [
        "Combobox.vue",
        "types.ts",
        "index.ts"
      ],
      "entry": "index.ts",
      "exports": [
        "Combobox"
      ],
      "dependencies": [],
      "registryDependencies": [],
      "props": []
    },
    "angular": {
      "status": "complete",
      "files": [
        "index.ts",
        "combobox.component.ts"
      ],
      "entry": "index.ts",
      "selector": "ui-combobox",
      "exports": [
        "ComboboxComponent",
        "ComboboxOption"
      ],
      "dependencies": [],
      "props": []
    },
    "react-native": {
      "status": "missing",
      "notes": "Mobile uses native picker instead of combobox.",
      "webOnly": true,
      "props": []
    },
    "flutter": {
      "status": "missing",
      "notes": "Flutter has DropdownButton built-in.",
      "webOnly": true,
      "props": []
    }
  },
  "a11y": {
    "keyboard": [
      "ArrowDown/ArrowUp navigate items in the dropdown."
    ],
    "aria": [
      "Trigger exposes role=combobox with aria-expanded."
    ]
  },
  "notes": {
    "mobile": "Web-only component — use platform-native equivalents on mobile."
  }
}
