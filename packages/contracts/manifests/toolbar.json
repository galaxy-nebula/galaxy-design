          "type": {
            "kind": "union",
            "values": [
              {
                "kind": "literal",
                "value": "horizontal"
              },
              {
                "kind": "literal",
                "value": "vertical"
              }
            ]
          },
          "default": "horizontal",
          "description": "Toolbar orientation."
        },
        {
          "name": "dir",
          "type": {
            "kind": "union",
            "values": [
              {
                "kind": "literal",
                "value": "ltr"
              },
              {
                "kind": "literal",
                "value": "rtl"
              }
            ]
          },
          "default": "ltr",
          "description": "Reading direction for roving focus."
        },
        {
          "name": "loop",
          "type": {
            "kind": "primitive",
            "name": "boolean"
          },
          "default": true,
          "description": "Loop keyboard focus from last item to first."
        },
        {
          "name": "as",
          "type": {
            "kind": "custom",
            "name": "AsTag | Component"
          },
          "default": "div",
          "description": "Element or component to render."
        },
        {
          "name": "class",
          "type": {
            "kind": "primitive",
            "name": "string"
          },
          "default": "",
          "description": "CSS class names for the toolbar root."
        }
      ]
    },
    "angular": {
      "status": "complete",
      "files": [
        "toolbar.component.ts",
