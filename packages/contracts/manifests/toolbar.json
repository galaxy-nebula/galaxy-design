{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "toolbar",
  "name": "Toolbar",
  "category": "data-display",
  "status": "complete",
  "description": "Toolbar component with section grouping and separators for grouped actions.",
  "props": [
    {
      "name": "orientation",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "horizontal"
          },
          {
            "kind": "literal",
            "value": "vertical"
          }
        ]
      },
      "default": "horizontal",
      "description": "Toolbar orientation. Example: <Toolbar orientation=\"vertical\">",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "dir",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "ltr"
          },
          {
            "kind": "literal",
            "value": "rtl"
          }
        ]
      },
      "default": "ltr",
      "description": "Reading direction for roving focus. Example: <Toolbar dir=\"rtl\">",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "loop",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "default": true,
      "description": "Loop keyboard focus from last item to first. Example: <Toolbar loop={false}>",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "class",
      "type": {
        "kind": "primitive",
        "name": "string"
      },
      "default": "",
      "description": "CSS class names for the toolbar root. Example: <Toolbar class=\"border rounded-md\">",
      "frameworks": [
        "vue",
        "angular",
        "react"
      ],
      "overrides": {
        "react": {
          "name": "className"
        }
      }
    },
    {
      "name": "children",
      "type": {
        "kind": "custom",
        "name": "ReactNode"
      },
      "description": "Toolbar content. Example: <Toolbar><ToolbarButton>Bold</ToolbarButton></Toolbar>",
      "frameworks": [
        "react"
      ]
    },
    {
      "name": "as",
      "type": {
        "kind": "custom",
        "name": "AsTag | Component"
      },
      "default": "div",
      "description": "Element or component to render. Example: <Toolbar as=\"nav\">",
      "frameworks": [
        "vue"
      ]
    }
  ],
