{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "dropdown-menu",
  "name": "dropdown-menu",
  "category": "other",
  "status": "complete",
  "description": "Menu of actions or options revealed by a trigger button, for row actions and toolbar overflow.",
  "props": [
    {
      "name": "open",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "react-native"],
      "description": "Controlled open state."
    },
    {
      "name": "defaultOpen",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": false,
      "description": "Initial open state for uncontrolled usage."
    },
    {
      "name": "onOpenChange",
      "type": {
        "kind": "function",
        "signature": "(open: boolean) => void"
      },
      "frameworks": ["react", "react-native"],
      "description": "Called when the open state changes."
    },
    {
      "name": "modal",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": true,
      "description": "Whether outside interaction is disabled while the menu is open."
    },
    {
      "name": "dir",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "ltr"
          },
          {
            "kind": "literal",
            "value": "rtl"
          }
        ]
      },
      "frameworks": ["react", "vue", "react-native"],
      "default": "ltr",
      "description": "Reading direction for keyboard navigation."
    },
    {
      "name": "children",
      "type": {
        "kind": "custom",
        "name": "ReactNode"
      },
      "frameworks": ["react", "react-native"],
      "description": "Dropdown menu composition content."
    },
    {
      "name": "update:open",
      "type": {
        "kind": "function",
        "signature": "(open: boolean) => void"
      },
      "frameworks": ["vue"],
      "description": "Emitted when the open state changes."
    },
    {
      "name": "trigger",
      "type": {
        "kind": "custom",
        "name": "Widget"
      },
      "frameworks": ["flutter"],
      "description": "Widget used to open the menu."
    },
    {
      "name": "items",
      "type": {
        "kind": "array",
        "of": {
          "kind": "custom",
          "name": "GalaxyDropdownMenuItem<T>"
        }
      },
      "frameworks": ["flutter"],
      "description": "Menu items rendered in the popup."
    },
    {
      "name": "onSelected",
      "type": {
        "kind": "function",
        "signature": "(value: T) => void"
      },
      "frameworks": ["flutter"],
      "description": "Called when an item is selected."
    }
  ],
