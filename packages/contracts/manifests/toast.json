{
  "$schema": "../schemas/component-manifest.schema.json",
  "id": "toast",
  "name": "Toast",
  "category": "feedback",
  "status": "complete",
  "description": "Brief, auto-dismissing notification surfaced at the edge of the screen.",
  "props": [
    {
      "name": "theme",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "light"
          },
          {
            "kind": "literal",
            "value": "dark"
          },
          {
            "kind": "literal",
            "value": "system"
          }
        ]
      },
      "default": "light",
      "description": "Visual theme for the toaster. Example: <Toaster theme=\"dark\" />",
      "frameworks": [
        "react",
        "vue",
        "angular"
      ]
    },
    {
      "name": "position",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "top-left"
          },
          {
            "kind": "literal",
            "value": "top-center"
          },
          {
            "kind": "literal",
            "value": "top-right"
          },
          {
            "kind": "literal",
            "value": "bottom-left"
          },
          {
            "kind": "literal",
            "value": "bottom-center"
          },
          {
            "kind": "literal",
            "value": "bottom-right"
          }
        ]
      },
      "description": "Screen position for toast notifications. Example: <Toaster position=\"top-right\" />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "expand",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "description": "Whether stacked toasts can expand to show full content. Example: <Toaster expand />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "richColors",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "description": "Enable richer semantic color styling. Example: <Toaster richColors />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "closeButton",
      "type": {
        "kind": "primitive",
        "name": "boolean"
      },
      "description": "Show a close button on each toast. Example: <Toaster closeButton />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "duration",
      "type": {
        "kind": "primitive",
        "name": "number"
      },
      "description": "Default duration in milliseconds. Example: <Toaster duration={6000} />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "visibleToasts",
      "type": {
        "kind": "primitive",
        "name": "number"
      },
      "description": "Maximum number of visible toasts. Example: <Toaster visibleToasts={3} />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "offset",
      "type": {
        "kind": "custom",
        "name": "string | number"
      },
      "description": "Offset from the viewport edge. Example: <Toaster offset=\"24px\" />",
      "frameworks": [
        "react",
        "vue"
      ]
    },
    {
      "name": "dir",
      "type": {
        "kind": "union",
        "values": [
          {
            "kind": "literal",
            "value": "ltr"
          },
          {
            "kind": "literal",
            "value": "rtl"
          }
        ]
      },
      "default": "ltr",
      "description": "Reading direction. Example: <Toaster dir=\"rtl\" />",
      "frameworks": [
        "react",
        "vue"
      ]
    }
  ],
